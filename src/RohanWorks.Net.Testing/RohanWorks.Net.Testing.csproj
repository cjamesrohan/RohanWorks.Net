<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>RohanWorks.Net.Testing</PackageId>
    <Version>1.0.0</Version>
    <Authors>Coty Rohan</Authors>
    <Description>Testing helpers for .NET — fluent ILogger&lt;T&gt; assertion wrappers over Moq with full coverage of all log levels, EventId, exception, and scope overloads.</Description>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/RohanWorks/RohanWorks.Net</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>testing;logging;moq;assertions;xunit</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="6.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.*" />
    <PackageReference Include="Moq" Version="4.*" />
  </ItemGroup>

</Project>
