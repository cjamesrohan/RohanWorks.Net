<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>RohanWorks.Net.Results</PackageId>
    <Version>1.0.0</Version>
    <Authors>Coty Rohan</Authors>
    <Description>Result&lt;T&gt; pattern with fluent builder for ASP.NET Core APIs — supports both IActionResult (controllers) and IResult (minimal APIs), with typed exception dispatch and 424 helpers.</Description>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/RohanWorks/RohanWorks.Net</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>result;aspnetcore;api;railway;fluent</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
